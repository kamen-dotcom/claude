{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klimaticiplovdiv",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Default deploy publishes to klimaticiplovdiv.<subdomain>.workers.dev.
  // It does NOT bind the custom domain, because klimaticiplovdiv.com is not
  // yet a zone in this Cloudflare account — it currently uses the
  // ns41/ns42.superhosting.bg nameservers.
  //
  // Once the domain is added to Cloudflare and its nameservers are switched
  // at the registrar, bind the domain with:
  //
  //     npx wrangler deploy --env domain
  //
  "env": {
    "domain": {
      "routes": [
        { "pattern": "klimaticiplovdiv.com", "custom_domain": true },
        { "pattern": "www.klimaticiplovdiv.com", "custom_domain": true }
      ]
    }
  }
}
